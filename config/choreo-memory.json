{
  "memory": {
    "limits": {
      "heap": "6144m",
      "rss": "7680m",
      "external": "512m"
    },
    "optimization": {
      "gc": {
        "interval": 30000,
        "aggressive": false,
        "incremental": true
      },
      "v8": {
        "flags": [
          "--max-old-space-size=6144",
          "--max-semi-space-size=128",
          "--optimize-for-size",
          "--use-idle-notification"
        ]
      }
    },
    "monitoring": {
      "enabled": true,
      "interval": 30000,
      "alertThreshold": 4096
    }
  }
}