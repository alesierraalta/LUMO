# Development Environment Configuration
# Next.js 15.3.1 Development Server Optimization
# Copy this to .env.development.local in project root

# Node.js Memory and Performance Optimization
NODE_OPTIONS="--max-old-space-size=6144 --no-deprecation --no-warnings"

# Next.js Development Configuration
NEXT_TELEMETRY_DISABLED=1
NEXT_PRIVATE_STANDALONE=true
NEXT_PRIVATE_LOCAL_WEBPACK=true

# Webpack Performance Optimization
WEBPACK_CACHE_TYPE=filesystem
WEBPACK_CACHE_COMPRESSION=gzip
WEBPACK_PARALLELISM=4

# Supabase Polyfill Configuration
SUPABASE_POLYFILL_ENABLED=true
SUPABASE_POLYFILL_DEBUG=true
EDGE_RUNTIME_POLYFILL=true

# Development Server Optimization
FAST_REFRESH=true
TURBOPACK=false
NEXT_PRIVATE_DEBUG_CACHE=false

# Error Handling Configuration
SUPPRESS_WEBPACK_WARNINGS=true
SUPPRESS_POLYFILL_WARNINGS=false

# Build Performance
NEXT_PRIVATE_SKIP_VALIDATION=false
NEXT_PRIVATE_PROFILER=false

# Development Database (if different from production)
# Uncomment and configure if using different database for development
# DATABASE_URL_DEV=your_dev_database_url_here

# Debug Configuration
DEBUG_MIDDLEWARE=false
DEBUG_POLYFILL=true
DEBUG_MODULE_RESOLUTION=false

# Memory Management
NODE_MAX_OLD_SPACE_SIZE=6144
UV_THREADPOOL_SIZE=128

# Performance Monitoring
MEASURE_BUILD_TIME=true
MEASURE_STARTUP_TIME=true

# Development Flags
DEV_MODE=true
DEVELOPMENT_SERVER=true
POLYFILL_ACTIVE=true 