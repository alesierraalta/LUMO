{
  "title": "LUMO Error Tracking Dashboard",
  "version": "1.0.0",
  "widgets": [
    {
      "type": "error-rate",
      "title": "Error Rate (per minute)",
      "threshold": 5,
      "timeWindow": "1h"
    },
    {
      "type": "critical-errors",
      "title": "Critical Errors",
      "threshold": 1,
      "timeWindow": "24h"
    },
    {
      "type": "response-time",
      "title": "Average Response Time",
      "threshold": 5000,
      "timeWindow": "1h"
    },
    {
      "type": "memory-usage",
      "title": "Memory Usage",
      "threshold": 90,
      "timeWindow": "5m"
    },
    {
      "type": "error-categories",
      "title": "Error Categories",
      "categories": [
        "authentication",
        "database",
        "validation",
        "external-service",
        "application"
      ]
    }
  ],
  "alerts": [
    {
      "name": "high-error-rate",
      "condition": "error_rate > 5",
      "severity": "warning",
      "notification": [
        "email",
        "slack"
      ]
    },
    {
      "name": "critical-error",
      "condition": "severity = critical",
      "severity": "critical",
      "notification": [
        "email",
        "slack",
        "sms"
      ]
    },
    {
      "name": "slow-response",
      "condition": "response_time > 5000",
      "severity": "warning",
      "notification": [
        "email"
      ]
    }
  ]
}