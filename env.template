# LUMO Inventory System - Environment Configuration Template
# Copy this file to .env.local for development or .env for production

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment mode (development, production, test)
NODE_ENV=production

# Application version (automatically set during build)
NEXT_PUBLIC_APP_VERSION=0.1.0

# Server configuration
PORT=8080
HOSTNAME=0.0.0.0

# =============================================================================
# AUTHENTICATION (Clerk)
# =============================================================================

# Clerk publishable key (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# Clerk secret key (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_your-secret-key-here

# Skip authentication for development/testing (true/false)
NEXT_PUBLIC_SKIP_CLERK_AUTH=false

# Clerk webhook secret (optional, for webhook endpoints)
CLERK_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection URL
DATABASE_URL=postgresql://lumo_user:lumo_password@localhost:5432/lumo_inventory

# Individual database settings (used by Docker Compose)
POSTGRES_DB=lumo_inventory
POSTGRES_USER=lumo_user
POSTGRES_PASSWORD=lumo_password
POSTGRES_PORT=5432

# Database connection pool settings
DATABASE_CONNECTION_LIMIT=20
DATABASE_POOL_TIMEOUT=60000

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching and sessions)
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=lumo_redis_pass
REDIS_PORT=6379

# =============================================================================
# FILE STORAGE (Optional)
# =============================================================================

# Local storage path for uploads
UPLOAD_DIR=./uploads

# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email sender information
EMAIL_FROM=noreply@lumo-inventory.com
EMAIL_FROM_NAME=LUMO Inventory System

# =============================================================================
# API KEYS & EXTERNAL SERVICES
# =============================================================================

# OpenAI API key (optional, for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Stripe API keys (optional, for payments)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key-here
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn-here

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable/disable request logging
ENABLE_REQUEST_LOGGING=true

# Grafana admin password (for Docker monitoring stack)
GRAFANA_PASSWORD=admin

# Prometheus port (for Docker monitoring stack)
PROMETHEUS_PORT=9090

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development server port
DEV_PORT=3000

# Enable/disable TypeScript checking during development
NEXT_TYPESCRIPT_IGNORE_BUILD_ERRORS=false

# Enable/disable ESLint during development
NEXT_ESLINT_IGNORE_BUILD_ERRORS=false

# Hot reload settings for Docker development
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# JWT secret for session management (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars

# CSRF protection token (generate a strong random string)
CSRF_SECRET=your-csrf-secret-key-here

# Session cookie settings
SESSION_COOKIE_NAME=lumo-session
SESSION_MAX_AGE=86400

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# DOCKER COMPOSE SETTINGS
# =============================================================================

# Docker Compose profile to use (dev, full, proxy, admin, monitoring)
COMPOSE_PROFILES=

# Database admin interface port (Adminer)
ADMINER_PORT=8081

# Grafana dashboard port
GRAFANA_PORT=3001

# =============================================================================
# CSS & STATIC FILES
# =============================================================================

# CDN URL for static assets (optional)
NEXT_PUBLIC_CDN_URL=

# Enable/disable static file optimization
OPTIMIZE_STATIC_FILES=true

# CSS compilation mode (development only)
CSS_MINIMIZE=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable specific features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_ADVANCED_REPORTS=true
NEXT_PUBLIC_ENABLE_MULTI_TENANT=false
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Automatic backup settings
ENABLE_AUTO_BACKUP=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Enable/disable caching
ENABLE_REDIS_CACHE=false
CACHE_TTL=3600

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Image optimization settings
NEXT_PUBLIC_OPTIMIZE_IMAGES=true
IMAGE_QUALITY=80
IMAGE_FORMATS=webp,avif

# =============================================================================
# CHOREO DEPLOYMENT (Production Platform Specific)
# =============================================================================

# Choreo platform specific variables
CHOREO_PROJECT_ID=
CHOREO_ENVIRONMENT=production

# Health check endpoints
HEALTH_CHECK_ENDPOINT=/api/health
READINESS_CHECK_ENDPOINT=/api/ready

# =============================================================================
# EXAMPLE VALUES - REPLACE WITH ACTUAL VALUES
# =============================================================================

