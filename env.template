# =============================================================================
# LUMO INVENTORY SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# This file serves as a template for environment variable configuration

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application settings
NODE_ENV=production
PORT=8080
HOSTNAME=0.0.0.0

# =============================================================================
# AUTHENTICATION (Custom JWT)
# =============================================================================

# JWT Secret Key (minimum 32 characters for security)
JWT_SECRET=your-super-secure-jwt-secret-key-here-minimum-32-characters

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection URL (REQUIRED)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=https://your-app.choreoapps.dev

# Application version
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ADVANCED_REPORTS=true

# Logging level (production should be info or warn)
LOG_LEVEL=info

# =============================================================================
# PRODUCTION EXAMPLE
# =============================================================================

# Replace these values with your actual Choreo deployment values:
# DATABASE_URL=postgresql://user:password@your-db-host:5432/lumo_db
# JWT_SECRET=your-actual-32-character-secret-key-here

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching and sessions)
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=lumo_redis_pass
REDIS_PORT=6379

# =============================================================================
# FILE STORAGE (Optional)
# =============================================================================

# Local storage path for uploads
UPLOAD_DIR=./uploads

# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email sender information
EMAIL_FROM=noreply@lumo-inventory.com
EMAIL_FROM_NAME=LUMO Inventory System

# =============================================================================
# API KEYS & EXTERNAL SERVICES
# =============================================================================

# OpenAI API key (optional, for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Stripe API keys (optional, for payments)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key-here
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn-here

# =============================================================================
# ADVANCED LOGGING CONFIGURATION
# =============================================================================

# Enable/disable console logging
ENABLE_CONSOLE_LOGS=true

# Enable/disable file logging
ENABLE_FILE_LOGS=true

# Log file configuration
LOG_FILE_PATH=./logs/application.log
LOG_MAX_FILE_SIZE=10485760
LOG_MAX_FILES=5

# Log format (json, text)
LOG_FORMAT=json

# Include stack traces in logs (development only recommended)
INCLUDE_STACK_TRACE=false

# Enable PII sanitization in logs
SANITIZE_PII=true

# Log buffer configuration
LOG_BUFFER_SIZE=100
LOG_FLUSH_INTERVAL=1000

# Enable/disable request logging
ENABLE_REQUEST_LOGGING=true

# Logger Configuration
LOG_DB_ENABLED=true
LOG_AUTH_ENABLED=true
LOG_CORRELATION_ENABLED=true
LOG_PERFORMANCE_ENABLED=true
LOG_ERROR_ENABLED=true
LOG_SECURITY_ENABLED=true
LOG_HEALTH_ENABLED=true

# Environment Detection
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# CHOREO SPECIFIC LOGGING
# =============================================================================

# Choreo deployment flag
CHOREO_DEPLOYMENT=false

# Choreo service information
CHOREO_SERVICE_NAME=lumo-inventory
CHOREO_VERSION=1.0.0
CHOREO_ENVIRONMENT=development
CHOREO_REGION=default
CHOREO_INSTANCE_ID=

# =============================================================================
# SECURITY LOGGING
# =============================================================================

# Failed login attempt thresholds
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Security alert thresholds
ACTIVE_THREATS_THRESHOLD=10
HIGH_MEMORY_THRESHOLD=90

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================

# Slow query threshold (milliseconds)
SLOW_QUERY_THRESHOLD=100

# Database connection monitoring
DB_CONNECTION_POOL_MONITORING=true

# Performance metrics collection
ENABLE_PERFORMANCE_METRICS=true

# Web Vitals tracking
ENABLE_WEB_VITALS=true

# Grafana admin password (for Docker monitoring stack)
GRAFANA_PASSWORD=admin

# Prometheus port (for Docker monitoring stack)
PROMETHEUS_PORT=9090

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development server port
DEV_PORT=3000

# Enable/disable TypeScript checking during development
NEXT_TYPESCRIPT_IGNORE_BUILD_ERRORS=false

# Enable/disable ESLint during development
NEXT_ESLINT_IGNORE_BUILD_ERRORS=false

# Hot reload settings for Docker development
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# CSRF protection token (generate a strong random string)
CSRF_SECRET=your-csrf-secret-key-here

# Session cookie settings
SESSION_COOKIE_NAME=lumo-session
SESSION_MAX_AGE=86400

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://your-domain.choreoapps.dev

# =============================================================================
# DOCKER COMPOSE SETTINGS
# =============================================================================

# Docker Compose profile to use (dev, full, proxy, admin, monitoring)
COMPOSE_PROFILES=

# Database admin interface port (Adminer)
ADMINER_PORT=8081

# Grafana dashboard port
GRAFANA_PORT=3001

# =============================================================================
# CSS & STATIC FILES
# =============================================================================

# CDN URL for static assets (optional)
NEXT_PUBLIC_CDN_URL=

# Enable/disable static file optimization
OPTIMIZE_STATIC_FILES=true

# CSS compilation mode (development only)
CSS_MINIMIZE=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable specific features
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_MULTI_TENANT=false
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Automatic backup settings
ENABLE_AUTO_BACKUP=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Enable/disable caching
ENABLE_REDIS_CACHE=false
CACHE_TTL=3600

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Image optimization settings
NEXT_PUBLIC_OPTIMIZE_IMAGES=true
IMAGE_QUALITY=80
IMAGE_FORMATS=webp,avif

# =============================================================================
# CHOREO DEPLOYMENT (Production Platform Specific)
# =============================================================================

# Choreo platform specific variables
CHOREO_PROJECT_ID=
CHOREO_ENVIRONMENT=production

# Health check endpoints
HEALTH_CHECK_ENDPOINT=/api/health
READINESS_CHECK_ENDPOINT=/api/ready

# =============================================================================
# EXAMPLE VALUES - REPLACE WITH ACTUAL VALUES
# =============================================================================

# Development example:
# DATABASE_URL=postgresql://lumo_user:lumo_password@localhost:5432/lumo_inventory_dev
# NEXT_PUBLIC_SKIP_CLERK_AUTH=true

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000" 