{
  "name": "new-inventory-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:clerk": "node create-env-local.js && next dev",
    "dev:no-auth": "node create-env-local.js --skip-auth && next dev",
    "dev:prod-keys": "cross-env NODE_ENV=production node create-env-local.js && next dev",
    "dev:prod-test": "node create-env-local.js dev:prod-test && next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "node minimal-fix.js && node safe-server.js",
    "start:standalone": "node minimal-fix.js && node safe-server.js",
    "start:original": "node minimal-fix.js && node server.js",
    "start:debug": "node debug-startup.js",
    "fix-manifests": "node scripts/fix-manifests.js",
    "preload-fix": "node preload-fix.js",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:init": "node src/scripts/init-db.js",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:setup": "prisma migrate deploy && node src/scripts/init-db.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.19.2",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.3.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slider": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-toast": "^1.2.11",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.503.0",
    "next": "15.3.1",
    "next-themes": "^0.4.6",
    "prisma": "^6.7.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.1",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.3",
    "postcss": "^8.4.47",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/webpack": "^5.28.5",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
